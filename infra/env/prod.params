# neo-06's OWN service (module 01: Agreement Management), on prod. Identical to
# dev.params — a module carries no environment-specific values (the orchestrator URL is built
# from the Cloud Map namespace in the template). The pipeline adds EnvironmentName + the
# PINNED @sha256 images + DbEndpoint + AlbDnsName.
ServiceName=neo-06
Role=module
PathPrefix=/neo-06
ListenerRulePriority=60
DbName=neo_06
ServiceId=neo06
DisplayName=Agreement Management
Domain=agreement
Team=Team 06
MockedDependencies=e-sign-provider, document-store
